# PiTasker settings (the server reads .env from its working directory).
# Required ────────────────────────────────────────────────────────────────
PORT=5007
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/pitasker
# openssl rand -hex 32 (min 16 characters; 32+ recommended)
SESSION_SECRET=

# Server ──────────────────────────────────────────────────────────────────
# Bind address (default 0.0.0.0; nginx proxies from the same host, so 127.0.0.1 works too)
#HOST=127.0.0.1
# Content-Security-Policy: Report-Only until this is true (watch pm2 logs for [csp] lines first)
CSP_ENFORCE=false
# The public origin; state-changing requests from another Origin are refused (default below)
#PITASKER_ORIGIN=https://pitasker.piapps.dev
# Count login attempts per CF-Connecting-IP: only when Cloudflare is in front AND the
# proxy doesn't already restore the client IP (piapps' nginx does: leave this off there)
#PITASKER_CLOUDFLARE=1

# Scheduling / runs ───────────────────────────────────────────────────────
# Zone for PiTasker's own schedules and next-run times (default: the host's zone)
#PITASKER_TZ=Asia/Taipei
# Kill a PiTasker run (its whole process group) after this many ms (default 300000)
#PITASKER_RUN_TIMEOUT_MS=300000
# Bytes kept per stream (stdout, stderr) per run, the tail (default 65536)
#PITASKER_OUTPUT_CAP=65536

# Crontab ─────────────────────────────────────────────────────────────────
# Backups of the crontab before every write go to $PITASKER_STATE_DIR/crontab-backups
#PITASKER_STATE_DIR=/home/zk/.local/state/pitasker
# The crontab binary (default: crontab on PATH)
#PITASKER_CRONTAB_BIN=/usr/bin/crontab
# Where cron-invoked scripts must live (bin.git); the editor warns otherwise
#PITASKER_BIN_DIR=/home/zk/bin
# Read `journalctl -u cron` for "last started" of crontab-run jobs (user needs journal access)
#PITASKER_CRON_JOURNAL=on

# Fleet view (2.1) — hub ─────────────────────────────────────────────────
# Agents: id=http://ip:5017,… (ids [a-z0-9-]; empty = the hub alone)
#PITASKER_HOSTS=piapps2=http://192.168.50.120:5017,piapps4=http://10.77.0.4:5017,piapps3=http://10.77.0.3:5017,hwca-ap02=http://10.77.0.5:5017
# One token per agent (from its ~/.config/pitasker/agent-token): id upper-cased, - → _
#PITASKER_HOST_TOKEN_PIAPPS2=
#PITASKER_HOST_LABELS=piapps2=piapps2 (LAN)
#PITASKER_HOST_PRODUCTION=hwca-ap02
# bin.git master for "bin replica differs" (default piapps2)
#PITASKER_BIN_MASTER=piapps2
# Where the root crontab snapshot unit writes (default below)
#PITASKER_ROOT_CRON_SNAPSHOT=/var/lib/pitasker/root-crontab
# /etc for /etc/crontab, cron.d and run-parts (default /etc; tests use fixtures)
#PITASKER_ETC_DIR=/etc

# Logs widget ─────────────────────────────────────────────────────────────
LOG_DIR=/home/zk/logs/pitasker
LOG_RETENTION_DAYS=7
LOG_CLEANUP_DRY_RUN=false

# npm run db:seed (first install only) ────────────────────────────────────
#PITASKER_ADMIN_USER=admin
#PITASKER_ADMIN_PASSWORD=
